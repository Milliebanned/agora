// Prisma ORM Schema for NimTrust

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User (wallet-based auth, no passwords)
model User {
  id          String   @id @default(cuid())
  address     String   @unique // Nimiq wallet address
  displayName String?
  bio         String?
  // Marketplace side chosen right after wallet connect.
  // "provider" = offers services, "client" = requires services.
  // Null until the user picks one on /onboarding.
  role        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sentAgreements     Agreement[]      @relation("Buyer")
  receivedAgreements Agreement[]      @relation("Seller")
  sentMessages       Message[]
  openedDisputes     Dispute[]        @relation("Opener")
  mediatedDisputes   Dispute[]        @relation("Mediator")
  receivedDisputes   Dispute[]        @relation("Respondent")
  reputationScores   ReputationScore?
  proposals          Proposal[]       @relation("Freelancer")
  serviceListings    ServiceListing[] @relation("Provider")
  notifications      Notification[]
}

// ServiceListing — a freelancer advertising what they do and what they charge
// ("I will design your logo, 300 NIM, 5 days").
//
// This is advertising, not a contract: no escrow, no money, no obligations. A
// client who wants one of these still hires through the normal funded
// opportunity, so every NIM that moves still moves through an Agreement and its
// HTLC. Keeping the two models apart is what stops an advertisement from ever
// looking like committed budget.
model ServiceListing {
  id           String @id @default(cuid())
  providerId   String
  provider     User   @relation("Provider", fields: [providerId], references: [id])

  title        String // "I will design your logo"
  description  String
  category     String
  serviceType  String?
  priceNIM     Decimal // what the freelancer charges, as advertised
  deliveryDays Int

  // published — visible on the client's Find workers board
  // paused    — kept, but off the board
  status String @default("published")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([providerId])
}

// Agreement — a marketplace opportunity across its whole life.
//
// One row carries the posting, the escrow, and the engagement, so the chat,
// milestones, escrow transactions and disputes that already hang off it stay
// attached when a posting turns into a contract. Lifecycle:
//
//   draft     posted by the client, budget not yet committed
//   open      escrow committed, listed on the public board, taking proposals
//   locked    a proposal was accepted, HTLC created, work under way
//   submitted freelancer handed in the work, awaiting the client's review
//   completed client approved, escrow released to the freelancer
//   disputed  either party escalated to the AI mediator
//   cancelled withdrawn before a freelancer was accepted
model Agreement {
  id          String @id @default(cuid())
  title       String
  description String @db.Text
  status      String @default("draft")

  // Structured posting fields (replaces the AI-drafted agreement flow)
  category     String? // see CATEGORIES in src/lib/opportunities.ts
  serviceType  String? // the specific service within the category
  timelineDays Int? // working days the client is asking for
  // Set when this posting was created by hiring from a freelancer's
  // advertisement, so an ad can say how many deals came out of it and refuse
  // to be deleted while one of them is still running.
  sourceListingId String?

  budgetNIM    Decimal? // budget as posted; amountNIM narrows to the accepted bid
  attachments  String   @default("[]") @db.Text // JSON array of { label, url }

  // Parties
  buyerId  String
  buyer    User    @relation("Buyer", fields: [buyerId], references: [id])
  sellerId String?
  seller   User?   @relation("Seller", fields: [sellerId], references: [id])

  // Terms
  amountNIM       Decimal // Escrow amount in NIM (== budgetNIM until a bid is accepted)
  deadline        DateTime
  deliverables    String   @db.Text // JSON array of strings
  completionTerms String   @db.Text
  refundTerms     String   @db.Text

  // HTLC Escrow
  htlcAddress  String? // Nimiq HTLC contract address (on-chain)
  htlcHashRoot String? // Hash of the release secret
  htlcPreImage String? // Release secret (revealed on approval)
  htlcTimeout  Int? // Block height expiration

  // Work handed in by the freelancer, reviewed by the client and, if it comes
  // to that, by the AI mediator against the deliverables above.
  workSubmission String? @db.Text

  // Risk Assessment (AI-generated)
  riskFlags String @db.Text // JSON array of risk warnings

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime? // escrow committed, listed on the board
  lockedAt        DateTime? // proposal accepted, HTLC created
  workSubmittedAt DateTime?
  completedAt     DateTime?

  // Relations
  proposals          Proposal[]
  milestones         Milestone[]
  escrowTransactions EscrowTransaction[]
  messages           Message[]
  disputes           Dispute[]

  // The board reads open postings newest-first; the profile reads by party.
  @@index([status, publishedAt])
  @@index([buyerId])
  @@index([sellerId])
}

// Proposal — a freelancer's pitch for an open opportunity.
//
// Proposals are the only contact before selection: the private chat opens once
// one is accepted, which is also the moment the HTLC is created on-chain.
model Proposal {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  freelancerId String
  freelancer   User   @relation("Freelancer", fields: [freelancerId], references: [id])

  coverLetter  String  @db.Text
  // Where the client can see work this freelancer has already done. The single
  // most useful thing a stranger can offer alongside a price.
  portfolioUrl String?
  bidNIM       Decimal
  deliveryDays Int
  status       String  @default("pending") // pending, accepted, rejected, withdrawn

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One pitch per freelancer per opportunity; they edit rather than re-post.
  @@unique([agreementId, freelancerId])
  @@index([agreementId, status])
}

// Milestone (deliverable checkpoint)
model Milestone {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  title       String
  description String  @db.Text
  status      String  @default("pending") // pending, submitted, approved, rejected
  deliverable String? @db.Text // Work submitted by seller, set on submission

  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  approvedAt  DateTime?
}

// Escrow Transaction (HTLC fund/claim/refund events)
model EscrowTransaction {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  // "fund"   the client's on-chain payment into the escrow wallet
  // "claim"  the payout from the escrow wallet to the freelancer
  // "refund" the escrow returned to the client
  type      String
  status    String   @default("pending") // pending, confirmed, failed
  txHash    String? // On-chain Nimiq transaction hash
  amountNIM Decimal? // What actually moved, for the outflow ceiling

  // Who actually sent an incoming payment. Nimiq Pay pays from the account the
  // user has active, which is not necessarily the one the app read at login, so
  // this is frequently not the same as the buyer's address — and the difference
  // is worth keeping rather than assuming away.
  fromAddress String?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  // The idempotency guarantee for payouts, enforced by the database rather than
  // by a check-then-act in application code: a second concurrent claim for the
  // same deal loses this insert and never reaches the signing step. One row per
  // movement type per deal is all the escrow lifecycle ever needs.
  @@unique([agreementId, type])
  @@index([type, status, createdAt])
}

// Message (agreement chat)
model Message {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  type    String @default("text") // text, system
  content String @db.Text

  createdAt DateTime @default(now())
}

// Dispute (conflict resolution)
model Dispute {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  openerId     String
  opener       User   @relation("Opener", fields: [openerId], references: [id])
  respondentId String
  respondent   User   @relation("Respondent", fields: [respondentId], references: [id])

  reason String
  status String @default("open") // open, under_review, resolved

  // AI Mediator Verdict
  caseSummary        String? @db.Text
  findings           String? @db.Text
  recommendedOutcome String? // "release", "refund", "partial_refund", "escalate"

  // What share of the escrow the mediator judged the freelancer to have earned:
  // 100 for a release, 0 for a refund, and the split it reasoned to for a
  // partial. Stored as the model returned it so the payout arithmetic and the
  // findings the parties read can never drift apart.
  freelancerPercent Int?

  // A verdict is a recommendation until both sides answer it. Neither the model
  // nor the platform can move money on its own: only two "accepted" here
  // authorise a settlement payout.
  //
  // Three states, not a boolean, because "has not looked yet" and "refuses" are
  // different facts and the other party deserves to know which they are waiting
  // on. null = undecided, "accepted", "rejected".
  openerDecision     String?
  respondentDecision String?

  // Human mediation. The AI's verdict is a recommendation both parties may
  // refuse; a platform mediator's ruling is binding, which is exactly why it
  // records who made it and what they said. A ruling nobody signed their name
  // to is not accountability, it is just another anonymous verdict.
  humanRequestedAt   DateTime? // a party asked for a person to look
  humanRequestedById String?
  mediatorId         String? // the platform mediator who ruled
  mediator           User?     @relation("Mediator", fields: [mediatorId], references: [id])
  humanRuling        String?   @db.Text // their reasoning, shown to both parties
  humanRulingPercent Int? // share of the escrow awarded to the freelancer
  ruledAt            DateTime?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// Reputation / Trust Score
model ReputationScore {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalAgreements     Int     @default(0)
  completedAgreements Int     @default(0)
  avgDeliveryDays     Decimal @default(0)
  disputeRate         Decimal @default(0) // percentage

  trustScore Int @default(0) // 0-100

  updatedAt DateTime @updatedAt
}

// Notification — something happened that one specific person should see.
//
// Stored per recipient rather than derived per request, because "has this
// person seen it yet" is the whole point and nothing else in the schema
// records it. `tab` holds the nav href the badge belongs on, so the counter
// and the navigation agree by construction instead of by a mapping table that
// can drift.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tab  String // e.g. "/dashboard/agreements"
  type String // proposal_received, proposal_accepted, message, dispute_opened, ...
  body String // one sentence, already written for the reader
  href String? // where clicking it should land

  agreementId String?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, readAt])
  @@index([userId, tab, readAt])
}
