# Nimiq Network Configuration
# Which chain this deployment is on. BOTH must be set and must agree — the
# server refuses to start a money operation rather than guess, because guessing
# wrong means looking for real payments on a chain they were never sent to.
# NEXT_PUBLIC_ is the browser's copy; NIMIQ_NETWORK is the server's.
NEXT_PUBLIC_NIMIQ_NETWORK=testnet
NIMIQ_NETWORK=testnet

# The endpoint used is chosen by the network above: mainnet reads
# NIMIQ_MAINNET_RPC_ENDPOINT, testnet reads NIMIQ_RPC_ENDPOINT.
NIMIQ_RPC_ENDPOINT=https://rpc.testnet.nimiqwatch.com
NIMIQ_MAINNET_RPC_ENDPOINT=https://rpc.nimiqwatch.com

# Authentication
JWT_SECRET=your-random-32-character-secret-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Google Gemini API (dispute mediator; agreements are a structured form, not AI-drafted)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides — defaults are set in src/lib/gemini.ts.
# gemini-3.8-flash is stronger but free-tier capped at 20 requests; switch to
# it once billing is enabled on the Google Cloud project.
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Escrow wallet
# The Nimiq account that holds budgets between funding and payout. Server-side
# only — never shipped to the browser; the client asks for the address through
# /api/opportunities/[id]/escrow.
#
# READ ESCROW.md BEFORE PUTTING A MAINNET KEY HERE. Whoever holds this key can
# move every NIM currently in escrow. On Vercel it lives in the same process as
# every npm dependency in the app.
NIMIQ_ESCROW_ADDRESS=
# 64 hex characters. Must derive to NIMIQ_ESCROW_ADDRESS or the server refuses
# to sign anything at all.
NIMIQ_ESCROW_PRIVATE_KEY=

# Nimiq network id used when signing. Derived from the network setting above
# (mainnet = 24, testnet = 5). A wrong value fails safe: the network rejects the
# transaction rather than paying the wrong account.
NIMIQ_NETWORK_ID=

# Network fee for payouts, in luna (1 NIM = 100,000 luna). Nimiq transfers are
# normally free, so 0 is fine; raise it if payouts sit unconfirmed.
ESCROW_PAYOUT_FEE_LUNA=0

# Rolling 24-hour ceiling on total payouts, in NIM. Past it, payouts refuse and
# log loudly instead of paying. 0 disables the ceiling — set a real number in
# production. Size it a little above your busiest expected day.
ESCROW_DAILY_LIMIT_NIM=0

# Shared secret for GET /api/admin/escrow-health, which reconciles the wallet
# balance against what the database says is owed. Point an uptime monitor at it
# and alert on healthy:false.
ESCROW_ADMIN_TOKEN=

# Dev only. Skips the on-chain confirmation of an escrow payment, so a mock
# wallet can publish a posting without money moving. NEVER set this in a
# deployed build: with it on, anyone can publish without paying.
NIMIQ_SKIP_ESCROW_VERIFICATION=false

# Block after which an unresolved deal is treated as abandoned and refundable.
HTLC_TIMEOUT_BLOCKS=14400

# Vercel/Deployment (optional)
VERCEL_URL=https://your-app.vercel.app
